{
  "name": "ball-and-chain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "feel": "tsx tools/feel.ts",
    "soak": "tsx tools/soak.ts",
    "botstats": "tsx tools/botstats.ts",
    "economy": "tsx tools/economy.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tweakpane/plugin-essentials": "0.2.1",
    "planck": "1.5.0",
    "three": "0.186.1",
    "tweakpane": "4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.56.1",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "prettier": "3.6.2",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
